{
  "name": "@kan/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./utils/supabase-server": {
      "types": "./src/utils/supabase-server.ts",
      "default": "./src/utils/supabase-server.ts"
    },
    "./utils/supabase": {
      "types": "./src/utils/supabase.ts",
      "default": "./src/utils/supabase.ts"
    }
  },
  "license": "GPL-3.0",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@kan/eslint-config": "workspace:*",
    "@kan/prettier-config": "workspace:*",
    "@kan/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "fast-check": "^4.9.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  },
  "prettier": "@kan/prettier-config",
  "dependencies": {
    "@kan/logger": "workspace:^",
    "@supabase/supabase-js": "^2.112.0",
    "date-fns": "^4.1.0",
    "jose": "^6.1.2",
    "nanoid": "^5.0.9",
    "next-runtime-env": "^1.7.2"
  }
}
