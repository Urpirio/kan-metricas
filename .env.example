# https://github.com/kanbn/kan?tab=readme-ov-file#environment-variables-)

# Required environment variables
NEXT_PUBLIC_BASE_URL= # e.g. https://kan.bn

# Still required after the migration to Supabase Auth — repurposed as the
# encryption key for stored secrets (see packages/api/src/utils/encryption.ts).
BETTER_AUTH_SECRET= # Random 32+ char string (can gen with: openssl rand -base64 26 | tr -dc 'a-zA-Z0-9' | head -c 32)

# Supabase client configuration (required for Supabase Auth and Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL= # URL of your Supabase project (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Supabase anonymous/public key — safe for browser use (found in Supabase Dashboard > Settings > API)
SUPABASE_SERVICE_ROLE_KEY= # Supabase service role key — server-only, NEVER expose to the browser (found in Supabase Dashboard > Settings > API)

# Fill if you want to use an external database
POSTGRES_URL= # e.g. postgresql://kan:your_password@your_host:5432/kan
POSTGRES_URL_NON_POOLING= # Direct (non-pooled) connection used for running migrations; required when using Supabase connection pooling. Falls back to POSTGRES_URL when unset (e.g. self-hosting)

# Only required if deploying from compose
POSTGRES_PASSWORD=

# Email (optional) — sent via Resend (https://resend.com)
# Create an API key at https://resend.com/api-keys. Resend requires a
# verified sending domain before you can send to arbitrary recipients.
# Note: this only covers app-sent emails (currently @-mention notifications).
# Magic link sign-in, workspace invites and password reset are still sent by
# Supabase Auth's own emailer — to route those through Resend too, set the
# same API key as SMTP credentials in the Supabase dashboard under
# Authentication > Emails > SMTP Settings (SMTP_HOST=smtp.resend.com,
# SMTP_USER=resend, SMTP_PASSWORD=<API key>).
RESEND_API_KEY=
EMAIL_FROM= # e.g. "Metricas <hello@yourdomain.com>"

# Switch email features off entirely (optional)
NEXT_PUBLIC_DISABLE_EMAIL=

# File storage now runs on Supabase Storage, not S3 directly — but these two
# S3_* vars are still read (legacy naming kept as-is to avoid a breaking env
# var rename):
S3_ENDPOINT= # allowlisted hostname for the attachment download proxy (apps/web/src/pages/api/download/attatchment.ts) — prevents SSRF via arbitrary URLs
# S3_AVATAR_UPLOAD_LIMIT=2097152 # Avatar upload size limit in bytes (default: 2MB)

# Supabase Storage (file uploads — avatars, attachments)
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_AVATAR_BUCKET_NAME=
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=
NEXT_PUBLIC_STORAGE_DOMAIN=
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=


# Auth config (optional)
NEXT_PUBLIC_ALLOW_CREDENTIALS=
NEXT_PUBLIC_DISABLE_SIGN_UP=

# API configuration (optional)
NEXT_API_BODY_SIZE_LIMIT= # e.g. 50mb (defaults to 1mb)

# Integration providers (optional)
TRELLO_APP_API_KEY=
TRELLO_APP_SECRET=

# Redis (optional - for rate limiting)
# If not provided, rate limiting will use in-memory storage
REDIS_URL= # e.g. redis://default:your_password@your_host:6379

# Logging (optional - debug, info, warn, error; defaults to debug in dev, info in prod)
LOG_LEVEL=

# OAuth providers (optional)
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional: Restrict OIDC/Social sign-ins to specific email domains (comma-separated)
BETTER_AUTH_ALLOWED_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
